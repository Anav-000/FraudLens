# Backend Environment Configuration
# Copy this file to .env for local overrides (never commit real secrets).

ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider Configuration
# Set to "gemini" for Google AI Studio / Gemini API integration
AI_PROVIDER=gemini

# Verified model ID with structured-output support, free-tier availability, and successful live verification
AI_MODEL=gemini-3.5-flash-lite

# Dedicated Gemini API key generated in Google AI Studio
# Leave empty in source control. Insert your key locally in .env only.
AI_API_KEY=

# Optional: Google Safe Browsing API key for URL reputation checking (v5 urls.search or v4 threatMatches:find)
# Noncommercial use only. Enable Google Safe Browsing API in Google Cloud Console
# and generate an API key. Leave empty to disable reputation checks.
SAFE_BROWSING_API_KEY=

# Safe Browsing API version: "v5" (default, GET /v5/urls:search) or "v4" (POST /v4/threatMatches:find)
SAFE_BROWSING_VERSION=v5
